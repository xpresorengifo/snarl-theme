<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;800&family=Permanent+Marker&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest"></script>

<style>
.snarl-footer {
    background-color: #000;
    border-top: 1px solid #1a1a1a;
    padding: 4rem 2rem 2rem;
    position: relative;
    overflow: hidden;
}
.snarl-footer-container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}
.snarl-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
    gap: 2rem;
    margin-bottom: 4rem;
}
.snarl-footer-brand .logo {
    display: block;
    margin-bottom: 1rem;
}
.snarl-footer-brand .logo img {
    height: 40px;
    width: auto;
}
.snarl-footer-tagline {
    color: #777;
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.snarl-footer-col h4 {
    color: #A8FF00;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}
.snarl-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
.snarl-footer-col ul li {
    margin-bottom: 0.8rem;
}
.snarl-footer-col ul li a {
    color: #CFCFCF;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    transition: color 0.3s;
}
.snarl-footer-col ul li a:hover {
    color: #fff;
}

.snarl-footer-newsletter p {
    color: #CFCFCF;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
}
.snarl-newsletter-form {
    display: flex;
}
.snarl-newsletter-form input {
    background: transparent;
    border: 1px solid #333;
    color: #fff;
    padding: 0.8rem 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    width: 100%;
    outline: none;
}
.snarl-newsletter-form button {
    background: #A8FF00;
    border: none;
    color: #000;
    padding: 0 1rem;
    cursor: pointer;
    transition: background 0.3s;
}
.snarl-newsletter-form button:hover {
    background: #b7ff33;
}

.snarl-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #1a1a1a;
    padding-top: 2rem;
}
.snarl-footer-copy {
    color: #555;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
}
.snarl-footer-social {
    display: flex;
    gap: 1.5rem;
}
.snarl-footer-social a {
    color: #fff;
    transition: color 0.3s;
}
.snarl-footer-social a:hover {
    color: #A8FF00;
}
.snarl-footer-legal {
    display: flex;
    gap: 1.5rem;
}
.snarl-footer-legal a {
    color: #555;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    transition: color 0.3s;
}
.snarl-footer-legal a:hover {
    color: #fff;
}

/* Background Deco */
.snarl-footer-graffiti {
    position: absolute;
    bottom: -10px;
    right: 20px;
    font-family: 'Permanent Marker', cursive;
    color: #fff;
    font-size: 6rem;
    opacity: 0.05;
    transform: rotate(-10deg);
    pointer-events: none;
    z-index: 1;
}

@media (max-width: 1024px) {
    .snarl-footer-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
    }
    .snarl-footer-bottom {
        flex-direction: column;
        gap: 1.5rem;
        text-align: center;
    }
}
</style>

<footer class="snarl-footer">
    <div class="snarl-footer-graffiti">NO RULES</div>
    
    <div class="snarl-footer-container">
        <div class="snarl-footer-grid">
            <div class="snarl-footer-brand">
                <a href="{{ routes.root_url }}" class="logo">
                    {% if section.settings.logo != blank %}
                        {{ section.settings.logo | image_url: width: 200 | image_tag }}
                    {% else %}
                        <img src="{{ 'nav-logo.png' | asset_url }}" alt="SNARL">
                    {% endif %}
                </a>
                <div class="snarl-footer-tagline">STREET CULTURE<br>WORLDWIDE</div>
            </div>
            
            <div class="snarl-footer-col">
                <h4>TIENDA</h4>
                <ul>
                    <li><a href="#">Todos los productos</a></li>
                    <li><a href="#">Polos</a></li>
                    <li><a href="#">Hoodies</a></li>
                    <li><a href="#">Gorras</a></li>
                    <li><a href="#">Accesorios</a></li>
                    <li><a href="#">Skate</a></li>
                </ul>
            </div>
            
            <div class="snarl-footer-col">
                <h4>AYUDA</h4>
                <ul>
                    <li><a href="#">Preguntas frecuentes</a></li>
                    <li><a href="#">Envíos y devoluciones</a></li>
                    <li><a href="#">Guía de tallas</a></li>
                    <li><a href="#">Formas de pago</a></li>
                    <li><a href="#">Términos y condiciones</a></li>
                </ul>
            </div>
            
            <div class="snarl-footer-col">
                <h4>NOSOTROS</h4>
                <ul>
                    <li><a href="#">Nuestra historia</a></li>
                    <li><a href="#">Lookbook</a></li>
                    <li><a href="#">Colaboraciones</a></li>
                    <li><a href="#">Trabaja con nosotros</a></li>
                    <li><a href="#">Contacto</a></li>
                </ul>
            </div>
            
            <div class="snarl-footer-newsletter snarl-footer-col">
                <h4>NEWSLETTER</h4>
                <p>Únete y recibe lanzamientos exclusivos y promociones especiales.</p>
                <form class="snarl-newsletter-form">
                    <input type="email" placeholder="Tu correo electrónico" required>
                    <button type="submit" aria-label="Suscribirse">
                        <i data-lucide="arrow-right" style="width: 18px; height: 18px;"></i>
                    </button>
                </form>
            </div>
        </div>
        
        <div class="snarl-footer-bottom">
            <div class="snarl-footer-copy">© 2024 SNARL. Todos los derechos reservados.</div>
            <div class="snarl-footer-social">
                <a href="#"><i data-lucide="instagram" style="width: 20px; height: 20px;"></i></a>
                <a href="#">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                </a>
                <a href="#"><i data-lucide="youtube" style="width: 20px; height: 20px;"></i></a>
            </div>
            <div class="snarl-footer-legal">
                <a href="#">Términos y condiciones</a>
                <a href="#">Política de privacidad</a>
            </div>
        </div>
    </div>
</footer>

<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>

{% schema %}
{
  "name": "SNARL Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo del footer"
    }
  ]
}
{% endschema %}
