<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;800&family=Permanent+Marker&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest"></script>

<style>
.snarl-adv-hero {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    background-color: #050505;
    overflow: hidden;
}
.snarl-adv-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}
.snarl-adv-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1; /* Oscurece un poco para leer el texto */
}

/* Gradient overlay */
.snarl-adv-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.7) 100%);
    z-index: 2;
}

.snarl-adv-hero-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Left Sidebar */
.snarl-adv-hero-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
}
.snarl-adv-hero-social {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}
.snarl-adv-hero-social a {
    color: #fff;
    transition: color 0.3s;
}
.snarl-adv-hero-social a:hover {
    color: #A8FF00;
}
.snarl-adv-hero-vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Inter', sans-serif;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

/* Center Content */
.snarl-adv-hero-center {
    flex: 1;
    padding-left: 5rem;
}
.snarl-adv-hero-brand {
    font-family: 'Inter', sans-serif;
    color: #fff;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    display: block;
}
.snarl-adv-hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 10vw, 8rem);
    color: #fff;
    line-height: 0.85;
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
}
.snarl-adv-hero-title span {
    color: #A8FF00;
    font-family: 'Permanent Marker', cursive;
    display: block;
    transform: rotate(-3deg);
    margin-left: 1rem;
}
.snarl-adv-hero-desc {
    font-family: 'Inter', sans-serif;
    color: #fff;
    font-size: 1.1rem;
    max-width: 400px;
    margin-bottom: 2rem;
    line-height: 1.5;
}
.snarl-adv-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #A8FF00;
    color: #000;
    padding: 1rem 2rem;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.3s ease;
}
.snarl-adv-hero-btn:hover {
    background-color: #b7ff33;
    transform: translateY(-2px);
}

/* Right Content */
.snarl-adv-hero-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    align-items: flex-end;
}
.snarl-adv-hero-graffiti {
    font-family: 'Permanent Marker', cursive;
    color: #A8FF00;
    font-size: 2.5rem;
    transform: rotate(-10deg);
    text-align: right;
    line-height: 1.2;
    margin-bottom: 10rem;
    opacity: 0.8;
}

@media (max-width: 1024px) {
    .snarl-adv-hero-left, .snarl-adv-hero-right {
        display: none;
    }
    .snarl-adv-hero-center {
        padding-left: 0;
    }
}
</style>

<section class="snarl-adv-hero">
    <div class="snarl-adv-hero-bg">
        {% if section.settings.bg_image != blank %}
            {{ section.settings.bg_image | image_url: width: 2000 | image_tag }}
        {% else %}
            <img src="{{ 'hero-principal---portada.png' | asset_url }}" style="width: 100%; height: 100%; object-fit: cover;">|<img src="{{ 'hero-principal---portada.png' | asset_url }}" style="width: 100%; height: 100%; object-fit: cover;">
        {% endif %}
    </div>

    <div class="snarl-adv-hero-container">
        <!-- Izquierda: Redes y texto vertical -->
        <div class="snarl-adv-hero-left">
            <div class="snarl-adv-hero-social">
                <a href="{{ section.settings.social_1 }}"><i data-lucide="instagram"></i></a>
                <a href="{{ section.settings.social_2 }}">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                </a>
                <a href="{{ section.settings.social_3 }}"><i data-lucide="youtube"></i></a>
            </div>
            <div class="snarl-adv-hero-vertical-text">
                {{ section.settings.vertical_text }}
            </div>
        </div>

        <!-- Centro: Título Principal y Botón -->
        <div class="snarl-adv-hero-center">
            <span class="snarl-adv-hero-brand">{{ section.settings.brand_text }}</span>
            <h1 class="snarl-adv-hero-title">
                {{ section.settings.title_line_1 }}<br>
                <span>{{ section.settings.title_line_2 }}</span><br>
                {{ section.settings.title_line_3 }}
            </h1>
            <p class="snarl-adv-hero-desc">
                {{ section.settings.description }}
            </p>
            <a href="{{ section.settings.button_link }}" class="snarl-adv-hero-btn">
                {{ section.settings.button_label }} <i data-lucide="arrow-right" style="width:18px;height:18px;"></i>
            </a>
        </div>

        <!-- Derecha: Graffiti -->
        <div class="snarl-adv-hero-right">
            <div class="snarl-adv-hero-graffiti">
                {{ section.settings.graffiti_text }}
            </div>
        </div>
    </div>
</section>

<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>

{% schema %}
{
  "name": "SNARL Portada Avanzada",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagen de fondo"
    },
    {
      "type": "header",
      "content": "Textos Centrales"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Texto pequeño superior",
      "default": "SNARL®"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Título Línea 1 (Blanco)",
      "default": "STREET"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Título Línea 2 (Brocha Verde)",
      "default": "CULTURE"
    },
    {
      "type": "text",
      "id": "title_line_3",
      "label": "Título Línea 3 (Blanco)",
      "default": "NO RULES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción breve",
      "default": "Ropa para los que rompen esquemas. Actitud. Estilo. Calle."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Detalles Laterales"
    },
    {
      "type": "text",
      "id": "vertical_text",
      "label": "Texto vertical izquierdo",
      "default": "MORE THAN CLOTHES A MOVEMENT"
    },
    {
      "type": "textarea",
      "id": "graffiti_text",
      "label": "Texto graffiti derecho",
      "default": "CREATE\nYOUR OWN\nPATH"
    }
  ],
  "presets": [
    {
      "name": "SNARL Portada Avanzada"
    }
  ]
},
  "presets": [
    {
      "name": "SNARL Portada Avanzada"
    }
  ]
}
{% endschema %}


